{
  "name": "website-promocao-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "watch:sass": "sass src/assets/sass/main.scss src/assets/css/styles.css -w",
    "compile:sass": "sass src/assets/sass/main.scss src/assets/css/styles.comp.css",
    "prefix:css": "postcss src/assets/css/styles.comp.css --use autoprefixer --output src/assets/css/styles.prefix.css",
    "compress:css": "postcss src/assets/css/styles.prefix.css --use cssnano --output src/assets/css/styles.css",
    "build:css": "npm-run-all compile:sass prefix:css compress:css"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "axios": "^1.10.0",
    "boxicons": "^2.1.4",
    "formik": "^2.4.6",
    "notyf": "^3.10.0",
    "npm-run-all": "^4.1.5",
    "plyr": "^3.8.3",
    "plyr-react": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-player": "^3.3.3",
    "react-router-dom": "^7.14.1",
    "swiper": "^12.1.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/aos": "^3.0.7",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@types/swiper": "^5.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "sass": "^1.80.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
